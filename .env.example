# =========================================================
# Inkora Deployment Environment Configuration
# Copy this file to .env and customize before deploying:
# cp .env.example .env
# =========================================================

# Database Configuration (MySQL 8)
MYSQL_DATABASE=inkora_db
MYSQL_USER=inkora_user
MYSQL_PASSWORD=change_this_strong_db_password
MYSQL_ROOT_PASSWORD=change_this_strong_root_password
MYSQL_EXTERNAL_PORT=3306

# Backend Configuration
PORT=8080
JWT_SECRET=Your64CharacterLongSecretKeyForSigningJWTTokensSecurityKey123456789
JPA_DDL_AUTO=update
SHOW_SQL=false

# Upload Directory (Inside container or local path)
UPLOAD_DIR=/app/uploads

# CORS Allowed Origins (Comma-separated URLs of frontend domains)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,https://yourdomain.com

# Frontend Public Port
APP_PORT=80

# Optional: Remote API URL if frontend is hosted separately on Vercel/Netlify
# VITE_API_BASE_URL=https://api.yourdomain.com/api
